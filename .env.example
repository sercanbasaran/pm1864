# Local: npm run setup writes .env interactively. Never commit .env.
# Netlify: add these variables in Project configuration > Environment variables.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Production: a PostgreSQL pooler URL, with TLS enabled as required by provider.
DATABASE_URL=
# Optional canonical origin; otherwise validated against the incoming request URL.
APP_ORIGIN=
# Webhook is the default. Use demo only for explicitly simulated deliveries.
SYNC_MODE=webhook
SYNC_ONLINE_URL=
SYNC_ONLINE_TOKEN=
SYNC_TRENDYOL_URL=
SYNC_TRENDYOL_TOKEN=
SYNC_YEMEKSEPETI_URL=
SYNC_YEMEKSEPETI_TOKEN=
SYNC_FINEDINE_URL=
SYNC_FINEDINE_TOKEN=

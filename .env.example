# First installation only: npm run setup writes .env interactively.
# Never commit .env. Existing accounts are managed inside the application.
# Netlify: configure variables for the Functions runtime.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Sistem Yöneticisi
# Production: a PostgreSQL pooler URL, with TLS enabled as required by provider.
DATABASE_URL=
# Optional canonical origin; otherwise validated against the incoming request URL.
APP_ORIGIN=
